{
  "_comment": "Copy to .mcp.json for local development against a server on :3000. Create the API key in the dashboard (Settings → API keys). Against the hosted app, drop CO_URL and use: claude mcp add codeoutbox -e CO_TOKEN=<key> -- npx -y codeoutbox mcp",
  "mcpServers": {
    "codeoutbox": {
      "command": "node",
      "args": ["packages/codeoutbox/bin/codeoutbox.mjs", "mcp"],
      "env": {
        "CO_URL": "http://localhost:3000",
        "CO_TOKEN": "REPLACE_WITH_YOUR_API_KEY"
      }
    }
  }
}
